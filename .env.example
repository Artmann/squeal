# Copy to `.env` — it is gitignored. Both variables are only read by
# `yarn seed` (scripts/seed.ts); the app itself needs neither, and the values
# below are the defaults the script already falls back to, matching the
# services in docker-compose.yml.

# The PostgreSQL instance `yarn seed` loads the Pagila sample data into.
# Note port 5433, not 5432 — docker-compose.yml maps it that way so it does
# not collide with a Postgres already running on the host.
POSTGRES_URL=postgresql://postgres:postgres@localhost:5433/squeal

# Where `yarn seed` writes the SQLite sample database. It is deleted and
# recreated on every run.
SQLITE_PATH=./seed-sqlite/pagila.sqlite
